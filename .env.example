# Quota Watch config — copy to .env (gitignored). Credentials stay local; never commit.

# Local dashboard port
QW_PORT=4319

# Which adapters to run (comma-separated): demo | manual | openai-health
QW_SOURCE=demo

# manual adapter: path to YOUR OWN exported usage JSON
# QW_MANUAL_FILE=./examples/manual-sample.json

# openai-compatible-health adapter: endpoint + key.
# The key is read ONLY from this env var — the tool never reads any credential store.
# QW_OPENAI_BASE_URL=https://your-openai-compatible-endpoint
# QW_OPENAI_API_KEY=replace-with-your-own-key
